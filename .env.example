# =============================================================================
# travian-discord-report-bot - configuration
# =============================================================================
# Settings stored in the DB OVERRIDE values from this file (except DISCORD_TOKEN,
# which is read ONLY from the environment and never stored in settings).

# --- Discord ----------------------------------------------------------------

# Bot token (SECRET - env only, never store it in the settings DB).
DISCORD_TOKEN=

# Channel ID where the daily report is posted (snowflake).
CHANNEL_ID=

# Optional dedicated channel for failure alerts (snowflake). EMPTY = alerts
# disabled. Environment-only: never stored in the settings DB, never shown
# in the dashboard. One best-effort Discord alert per failed fetch/report
# per UTC day (deduped via the job log); stale/gap/no-data states stay
# dashboard warnings and do NOT alert.
ALERT_CHANNEL_ID=

# Comma-separated list of alliance tags to include in reports, e.g. "AAA,BBB".
ALLIANCE_TAGS=

# Comma-separated list of ALL tracked alliances (allies + enemies) compared in
# the report's "Standings" field, e.g. "UFO,PR-U,AAA,BBB". OUR tags (from
# ALLIANCE_TAGS) are rendered bold. Empty = no Standings field.
TRACKED_ALLIANCES=

# Role ID allowed to trigger /raport (optional - empty means any member).
# In dashboard OAuth mode this is also the dashboard admin role: the first
# administrator must hold it — or be the server owner, or hold the Discord
# Administrator / Manage Server permission.
ADMIN_ROLE_ID=

# --- map.sql fetch schedule -------------------------------------------------

# Hour/minute (24h) and IANA time zone of the daily map.sql fetch.
# Default: 0:15 Europe/London
FETCH_HOUR=0
FETCH_MINUTE=15
FETCH_TZ=Europe/London

# --- Daily report schedule --------------------------------------------------

# Hour/minute (24h) and IANA time zone of the daily report.
# Default: 9:00 Europe/Warsaw
REPORT_HOUR=9
REPORT_MINUTE=0
REPORT_TZ=Europe/Warsaw

# --- Storage ----------------------------------------------------------------

# Path to the SQLite database file.
# Default: /data/travian.db
SQLITE_PATH=/data/travian.db

# --- Dashboard --------------------------------------------------------------

# Bind address and port of the dashboard (served in-process by uvicorn).
# Default: 127.0.0.1:8090. docker-compose overrides DASHBOARD_BIND to 0.0.0.0
# (the port is then published on all interfaces — see below).
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8090

# SECRET — required in token mode (DASHBOARD_AUTH_MODE=token, the default)
# whenever the dashboard is reachable beyond loopback (compose publishes
# port 8099 on all interfaces). Every /api/* route then requires
# `Authorization: Bearer <this token>`; the UI asks for it on first load.
# Complete OAuth mode (DASHBOARD_AUTH_MODE=oauth plus all OAUTH_* keys) does
# not use it. Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# Enforce loopback-only binding. "true" is ONLY safe together with a
# loopback-only port mapping (`127.0.0.1:8099:8090` in compose) — it disables
# the token, so with the port published on all interfaces it would leave the
# dashboard unauthenticated on the network. Keep "false" (or unset) for the
# standard LAN setup in this repo's compose.
DASHBOARD_LOOPBACK_ONLY=false

# Dashboard auth mode: "token" (default) | "oauth" | "none". Empty/unset
# falls back to the legacy heuristic (non-loopback bind + LOOPBACK_ONLY !=
# "true" → token, else none). "oauth" requires the three OAUTH_* keys below;
# if any is missing the dashboard falls back to token mode with a warning.
DASHBOARD_AUTH_MODE=token

# --- Discord OAuth (DASHBOARD_AUTH_MODE=oauth) ------------------------------
# Discord application Client ID / Client Secret (Dev Portal → OAuth2) and
# the numeric Discord server (guild) snowflake whose members may log in.
# Register the callback redirect per host/port you log in from:
#   http://<host>:<port>/api/auth/callback
# Members get a read-only dashboard (Settings/Actions hidden). Full control
# goes to ADMIN_ROLE_ID holders and to the server owner / Discord
# Administrator / Manage Server permission holders — use one of those to
# sign in first and set the role via Settings. Sessions are in-memory
# (restart = logout). Env only, never stored in the settings DB.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_GUILD_ID=
# The dashboard's public origin (scheme + host + port, no trailing path),
# e.g. http://192.168.1.164:8099 or https://dashboard.example.com. The
# OAuth redirect URI is built ONLY from this value — the request Host is
# never trusted. Required for oauth mode (missing → token fallback).
OAUTH_PUBLIC_ORIGIN=

# --- Report appearance ------------------------------------------------------

# Embed color as a hex value, e.g. 0x2ECC71.
REPORT_EMBED_COLOR=0x2ECC71

# --- Backfill (optional) ----------------------------------------------------

# Read-only Postgres DSN of the source snapshot DB for backfill (optional).
BACKFILL_DSN=
